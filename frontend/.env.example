# MedCheck AI frontend environment variables
# Copy this file to ".env" and adjust if the backend runs elsewhere.
#
# VITE_API_BASE_URL = base URL of the FastAPI backend.
# Default backend port is 8001 (port 8000 was avoided due to a Windows
# permission error). If you change the backend port, update this value to match.
VITE_API_BASE_URL=http://127.0.0.1:8001
